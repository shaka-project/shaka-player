  <BaseURL serviceLocation="test-cdn">../dash-multi-codec/</BaseURL>
  <ServiceDescription id="1">
    <ClientDataReporting schemeIdUri="urn:mpeg:dash:cta-5004:2023" serviceLocations="test-cdn">
      <CMCDParameters version="2" mode="query" includeInRequests="segment" keys="sid cid ot v sf br" contentID="dash-cmcd-content"/>
    </ClientDataReporting>
  </ServiceDescription>
  <Period id="0">
    <AdaptationSet id="6" contentType="video" maxWidth="180" maxHeight="144" frameRate="12800/512" par="5:4">
      <Representation id="12" bandwidth="162364" codecs="avc1.4d400c" mimeType="video/mp4" sar="1:1" width="180" height="144">
        <BaseURL>video_144p_108k_h264.mp4</BaseURL>
